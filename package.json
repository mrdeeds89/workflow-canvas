{
  "name": "workflow-canvas",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Visual workflow editor. Design only; no execution.",
  "engines": {
    "node": "22.23.4"
  },
  "scripts": {
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test test/*.test.ts",
    "api": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/http/main.ts",
    "smoke": "bash scripts/smoke-api.sh",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json",
    "build": "vite build"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@xyflow/react": "12.12.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
